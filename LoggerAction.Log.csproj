<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Version>1.1.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
	
    <!-- Metadados do pacote NuGet -->
    <PropertyGroup>
	    <PackageId>LoggerAction.Log</PackageId>
	    <Authors>Luis Roberto</Authors>
	    <Company>Luis Roberto</Company>
	    <Description>Middleware para ASP.NET Core que registra requests, responses e logs customizados no AWS CloudWatch, com envio assincrono, retry com backoff exponencial e truncamento seguro em UTF-8. Suporta tambem Workers e BackgroundJobs.</Description>
	    <PackageTags>aws;cloudwatch;logging;middleware;aspnetcore;observability;logger</PackageTags>
	    <PackageProjectUrl>https://github.com/Luis-Robertoo/LoggerAction</PackageProjectUrl>
	    <RepositoryUrl>https://github.com/Luis-Robertoo/LoggerAction</RepositoryUrl>
	    <RepositoryType>git</RepositoryType>
	    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	    <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- Simbolos e Source Link (o SDK do .NET 8 ja embute o Source Link para GitHub). -->
    <PropertyGroup>
	    <IncludeSymbols>true</IncludeSymbols>
	    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	    <PublishRepositoryUrl>true</PublishRepositoryUrl>
	    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
	    <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- O projeto vive na raiz do repositório: sem isto o glob padrão puxaria os testes para dentro da library. -->
    <ItemGroup>
	    <Compile Remove="tests\**" />
	    <None Remove="tests\**" />
    </ItemGroup>

    <ItemGroup>
	    <InternalsVisibleTo Include="LoggerAction.Log.Tests" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.7.3" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.0.21" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.8" />
  </ItemGroup>

</Project>
